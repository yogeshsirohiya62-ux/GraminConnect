{
  "version": 2,
  "installCommand": "npm --prefix frontend-host install && npm --prefix backend install",
  "buildCommand": "npm --prefix frontend-host run build",
  "outputDirectory": "frontend-host/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
